[Desktop Entry]
Type=Application
Name=修复键盘权限
Comment=配置udev规则以允许浏览器访问键盘设备
Exec=bash -c 'echo "SUBSYSTEM==\"hidraw\", ATTRS{idVendor}==\"413d\", MODE=\"0666\"" | sudo tee /etc/udev/rules.d/99-yywl-keyboard.rules > /dev/null && echo "SUBSYSTEM==\"hidraw\", ATTRS{idVendor}==\"8808\", MODE=\"0666\"" | sudo tee -a /etc/udev/rules.d/99-yywl-keyboard.rules > /dev/null && echo "SUBSYSTEM==\"hidraw\", ATTRS{idVendor}==\"514c\", MODE=\"0666\"" | sudo tee -a /etc/udev/rules.d/99-yywl-keyboard.rules > /dev/null && echo "SUBSYSTEM==\"hidraw\", ATTRS{idVendor}==\"1189\", MODE=\"0666\"" | sudo tee -a /etc/udev/rules.d/99-yywl-keyboard.rules > /dev/null && sudo udevadm control --reload-rules && sudo udevadm trigger && echo "" && echo "✅ 权限配置完成！请拔插键盘USB线后重新连接。" && sleep 5'
Icon=preferences-system
Terminal=true
Categories=System;
NoDisplay=false
