# ============================================================
# 部署凭据模板
# 用法: 复制本文件为 .env, 填入真实密码
#   copy .env.example .env
# .env 已被 .gitignore 忽略, 请勿提交真实凭据。
# 也可以不用 .env, 改设系统环境变量 (优先级更高):
#   [Environment]::SetEnvironmentVariable("FTP_PASS","<密码>","User")
# ============================================================

# 服务器 (nginx 的 /ws/ 就是 FTP 根目录)
FTP_HOST=key.itytsoft.com
FTP_USER=keyws

# FTP 密码 —— 服务器上修改密码后, 同步改这里
FTP_PASS=
