{
  "name": "yywl-quick-config",
  "version": "1.0.1",
  "description": "YYWL 键盘快速配置工具 - 新协议",
  "main": "electron.js",
  "scripts": {
    "dev": "node dev-server.js",
    "build": "vite build",
    "electron": "electron .",
    "dist": "vite build && electron-builder --win --config.win.signAndEditExecutable=false",
    "rebuild": "electron-rebuild -f -w node-hid"
  },
  "dependencies": {
    "node-hid": "^3.1.2"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "@electron/rebuild": "^3.7.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.yyt.quick-config",
    "productName": "YYWL快速配置",
    "directories": {
      "output": "dist-electron"
    },
    "npmRebuild": false,
    "files": [
      "electron.js",
      "preload.js",
      "dist/**/*",
      "node_modules/node-hid/**/*",
      "node_modules/pkg-prebuilds/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "portable": {
      "splashImage": "build/splash.bmp"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "YYWL快速配置"
    }
  }
}
